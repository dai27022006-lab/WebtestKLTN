# ==============================================================================
# Digital Store Advisor — Biến môi trường mẫu (KHÔNG điền secret thật vào file này)
# Copy thành .env.local khi phát triển ở máy cá nhân.
# ==============================================================================

# URL công khai của ứng dụng (dùng cho SEO metadata, sitemap, robots, redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database PostgreSQL + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server (API Routes / Server Actions), tuyệt đối không gắn NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (chỉ gọi từ server API, cấm gọi từ trình duyệt)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Mock Sandbox Payment Webhook Secret (chỉ dùng ở server)
MOCK_PAYMENT_WEBHOOK_SECRET=

# Google Analytics 4 Measurement ID (client tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
